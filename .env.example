# URL base da API (PrismaAPI, backend Spring Boot, perfil dev)
VITE_API_URL=http://localhost:9017/PrismaAPI/v1

# Com "true", a camada de servicos responde com dados mockados.
# Troque para "false" para falar com o PrismaAPI.
VITE_USE_MOCKS=true

# Latencia artificial (ms) aplicada aos mocks para simular rede e exercitar loadings.
VITE_MOCK_DELAY=450
