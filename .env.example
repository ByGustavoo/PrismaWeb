# URL base da API (backend Spring Boot que sera desenvolvido nas proximas etapas)
VITE_API_URL=http://localhost:8080/api

# Enquanto o backend nao existir, a camada de servicos responde com dados mockados.
# Troque para "false" quando a API real estiver disponivel.
VITE_USE_MOCKS=true

# Latencia artificial (ms) aplicada aos mocks para simular rede e exercitar loadings.
VITE_MOCK_DELAY=450
